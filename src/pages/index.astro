---
import Layout from '../components/layout.astro';
---

<style>
.steps {
  background: var(--light);
  display: grid;
  gap: 2rem;
  grid-template-columns: min(90vw, 250px);
  justify-content: center;
  margin-top: 3rem;
  padding: 5rem 5vw;
  width: 100vw;
}

@media (min-width: 550px) {
  .steps {
    grid-template-columns: repeat(2, min(calc(50% - 1rem), 250px));
  }
}

@media (min-width: 1050px) {
  .steps {
    grid-template-columns: repeat(4, min(calc(25% - 1.5rem), 250px));
  }
}

.step {
  background: var(--white);
  border: 1px solid var(--lightBorder);
  border-radius: var(--card-radius);
  display: flex;
  flex-direction: column;
  font-size: 0.75rem;
  padding: 1rem 1.5rem 1.5rem;
  text-align: left;
  box-shadow: 0 2px 4px rgb(14 30 37 / 12%);
}

.stepHeading {
  font-size: 1rem;
  font-weight: 600;
  margin: 0;
}


</style>

<Layout
  title="About Randy"
  description="Randy is not just another reminder app; it's your companion for a more mindful and present life. Whether you're looking to cultivate mindfulness, establish healthy habits, or simply stay on top of your daily tasks, Randy is here to support you in a unique and personalized way."
  home
>
  <main class="steps">
    <section class="step">
      <h2 class="stepHeading">How Randy Works?</h2>
      <p>
        Unlike traditional reminder apps that notify you at fixed times, Randy adds an <strong>element of surprise to your routine</strong>. You set the time interval, and Randy will randomly choose moments within that window to remind you. This unpredictability helps you stay present and engaged, making Randy perfect for mindfulness exercises, habit formation, or any activity where a little randomness can boost your awareness and focus.
      </p>
      <a href="/deploy-previews" class="button">
        Learn more <span class="sr-only">about How Randy Works</span>
      </a>
    </section>

    <section class="step">
      <h2 class="stepHeading">Key Features</h2>
      <p>
        Embrace the unexpected. Let Randy help you stay mindful, build habits, and bring a bit of spontaneity into your daily life.
      </p>
      <a href="/instant-rollbacks" class="button">
        Learn more <span class="sr-only">about Key Features</span>
      </a>
    </section>

    <section class="step">
      <h2 class="stepHeading">Why Randy?</h2>
      <p>
        Start your journey to a more mindful, engaged, and present life with Randy. Whether you’re looking to cultivate new habits or just need a little nudge to stay on track, Randy is the perfect companion for your daily routine.
      </p>
      <a href="/functions" class="button">
        Learn more <span class="sr-only">about Why Randy</span>
      </a>
    </section>

    <section class="step">
      <h2 class="stepHeading">ToDo</h2>
      <p>
        ToDo ToDo ToDo ToDo ToDo ToDo ToDo ToDo ToDo ToDo ToDo ToDo ToDo ToDo ToDo
        <strong>
            ToDo ToDo ToDo
        </strong>
      </p>
      <a href="/netlify-forms" class="button">
        Learn more <span class="sr-only">about ToDo</span>
      </a>
    </section>
  </main>
</Layout>
